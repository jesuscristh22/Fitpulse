# ===== FIREBASE (CLIENT — public, safe to expose) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== FIREBASE ADMIN (SERVER ONLY) =====
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ===== OPENAI (SERVER ONLY) =====
OPENAI_API_KEY=

# ===== CRON (SERVER ONLY) — protects /api/blog/generate from public calls =====
CRON_SECRET=

# ===== STRIPE =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs for the "Military AI Workout" one-time purchase (§29, §73).
# PT and ES share one EUR price. Create these in the Stripe Dashboard first.
STRIPE_PRICE_MILITARY_BR=
STRIPE_PRICE_MILITARY_EU=
STRIPE_PRICE_MILITARY_US=

# Used to build Stripe success/cancel redirect URLs when the request has no
# Origin header (e.g. some server-to-server calls). Set to your real domain,
# e.g. https://fitpulse-indol-rho.vercel.app
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
